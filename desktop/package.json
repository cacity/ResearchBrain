{
  "name": "researchbrain-desktop",
  "private": true,
  "version": "0.1.8",
  "license": "AGPL-3.0-only",
  "description": "Local-first literature library and evidence-grounded research desktop app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts ../README.md ../README.en.md ../docs ../.github",
    "format:check": "prettier --check src scripts ../README.md ../README.en.md ../docs ../.github",
    "chat:check": "node scripts/chat_render_check.cjs",
    "online:check": "node scripts/online_research_check.cjs",
    "library:check": "node scripts/library_state_check.cjs",
    "visual:check": "node scripts/visual_check.cjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
